# Optional provider settings. Keep real credentials in your local environment only.
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=

# Local application defaults
ROUTING_CONSOLE_HOST=127.0.0.1
ROUTING_CONSOLE_PORT=5174
ROUTING_CONSOLE_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# Offline mode is the safe default for portfolio and test use.
OFFLINE_MODE=true
ALLOW_REAL_API_CALLS=false

