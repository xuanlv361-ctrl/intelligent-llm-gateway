# Optional provider settings. Keep real credentials in your local environment only.
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=

# Local application defaults
ROUTING_CONSOLE_HOST=127.0.0.1
ROUTING_CONSOLE_PORT=5174
ROUTING_CONSOLE_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# Offline mode is the safe default for portfolio and test use.
OFFLINE_MODE=true
ALLOW_REAL_API_CALLS=false

# Optional direct-provider credentials for the Gateway workspace. Empty by
# default. Environment values alone never enable dispatch: the reviewed JSON
# execution policy, account permissions and per-request confirmation also apply.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=

